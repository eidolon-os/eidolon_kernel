[importlinter]
root_packages =
    eidolon_kernel
    eidolon_system
    eidolon_deploy

[importlinter:contract:domain]
name = Domain is independent
type = forbidden
source_modules =
    eidolon_kernel.domain
forbidden_modules =
    eidolon_kernel.application
    eidolon_kernel.ports
    eidolon_kernel.adapters
    eidolon_kernel.interfaces
    eidolon_kernel.composition
    eidolon_kernel.contracts

[importlinter:contract:ports]
name = Ports have no outer dependencies
type = forbidden
source_modules =
    eidolon_kernel.ports
forbidden_modules =
    eidolon_kernel.application
    eidolon_kernel.adapters
    eidolon_kernel.interfaces
    eidolon_kernel.composition
    eidolon_kernel.contracts

[importlinter:contract:application]
name = Application depends only inward
type = forbidden
source_modules =
    eidolon_kernel.application
forbidden_modules =
    eidolon_kernel.adapters
    eidolon_kernel.interfaces
    eidolon_kernel.composition
    eidolon_kernel.contracts

[importlinter:contract:contracts]
name = Contracts do not depend on implementations
type = forbidden
source_modules =
    eidolon_kernel.contracts
forbidden_modules =
    eidolon_kernel.application
    eidolon_kernel.adapters
    eidolon_kernel.interfaces
    eidolon_kernel.composition

[importlinter:contract:processes]
name = Kernel, System Manager and deployment operations are independent
type = independence
modules =
    eidolon_kernel
    eidolon_system
    eidolon_deploy

[importlinter:contract:deploy-core]
name = Deployment core does not depend on its Linux or CLI adapters
type = forbidden
source_modules =
    eidolon_deploy.activation
    eidolon_deploy.bundle
    eidolon_deploy.fingerprints
    eidolon_deploy.manifest
    eidolon_deploy.ports
    eidolon_deploy.prepare_target
    eidolon_deploy.sealing
forbidden_modules =
    eidolon_deploy.cli
    eidolon_deploy.linux

[importlinter:contract:system-domain]
name = System domain is independent
type = forbidden
source_modules =
    eidolon_system.domain
forbidden_modules =
    eidolon_system.application
    eidolon_system.ports
    eidolon_system.adapters
    eidolon_system.interfaces
    eidolon_system.composition
    eidolon_system.contracts

[importlinter:contract:system-ports]
name = System ports have no outer dependencies
type = forbidden
source_modules =
    eidolon_system.ports
forbidden_modules =
    eidolon_system.application
    eidolon_system.adapters
    eidolon_system.interfaces
    eidolon_system.composition
    eidolon_system.contracts

[importlinter:contract:system-application]
name = System application depends only inward
type = forbidden
source_modules =
    eidolon_system.application
forbidden_modules =
    eidolon_system.adapters
    eidolon_system.interfaces
    eidolon_system.composition
    eidolon_system.contracts
