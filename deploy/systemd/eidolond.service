[Unit]
Description=Eidolon OS local system manager
Wants=eidolon-bootstrapd.service
# The manager cannot start a unit itself; the applier's socket must be listening
# before it reconciles, or every start in the first pass fails on a missing path.
Requires=eidolon-unit-applier.socket
After=local-fs.target eidolon-bootstrapd.service eidolon-unit-applier.socket
StartLimitIntervalSec=0

[Service]
Type=simple
User=eidolon
Group=eidolon
UMask=0007
EnvironmentFile=/etc/eidolon/host.env
Environment=EIDOLON_SYSTEM_SETTINGS_YAML=/etc/eidolon/eidolond.yaml
ExecStart=/opt/eidolon/current/eidolon_kernel/.venv/bin/eidolond
Restart=always
RestartSec=3s
KillSignal=SIGTERM
TimeoutStopSec=20s
StateDirectory=eidolon
StateDirectoryMode=0750
RuntimeDirectory=eidolon
RuntimeDirectoryMode=0750
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
