#!/usr/bin/env python3
"""Render one private LiveKit config and exec the pinned server binary."""

from __future__ import annotations

import json
import os
import socket


def required(name: str) -> str:
    value = os.environ.get(name, "").strip()
    if not value:
        raise SystemExit(f"missing required LiveKit setting: {name}")
    return value


def node_ip() -> str:
    configured = os.environ.get("EIDOLON_LIVEKIT_NODE_IP", "").strip()
    if configured:
        return configured
    connection = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        connection.connect(("192.0.2.1", 9))
        return str(connection.getsockname()[0])
    finally:
        connection.close()


key = required("LIVEKIT_API_KEY")
secret = required("LIVEKIT_API_SECRET")
config = f"""\
port: 7880
bind_addresses: [\"0.0.0.0\"]
keys:
  {json.dumps(key)}: {json.dumps(secret)}
turn:
  enabled: true
  udp_port: 3478
rtc:
  use_external_ip: false
  node_ip: {json.dumps(node_ip())}
  port_range_start: 50000
  port_range_end: 60000
logging:
  level: info
  json: true
"""
path = "/run/eidolon/livekit/livekit.yaml"
descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_CLOEXEC, 0o600)
with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
    stream.write(config)
os.execv("/usr/local/bin/livekit-server", ("livekit-server", "--config", path))
