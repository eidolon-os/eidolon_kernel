[Unit]
Description=Eidolon Memory discovery API
After=local-fs.target eidolon-memory-supervisor.service
Wants=eidolon-memory-supervisor.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=eidolon
Group=eidolon
UMask=0007
EnvironmentFile=/etc/eidolon/memory.env
Environment=HOME=/var/lib/eidolon-runtime
Environment=EIDOLON_MEMORY_SETTINGS_YAML=/etc/eidolon/memory.yaml
ExecStart=/srv/eidolon/current/eidolon_memory/.venv/bin/eidolon-memory-discovery --host 127.0.0.1 --port 8020
Restart=on-failure
RestartSec=3s
KillSignal=SIGTERM
TimeoutStopSec=20s
StateDirectory=eidolon-runtime
StateDirectoryMode=0750
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
