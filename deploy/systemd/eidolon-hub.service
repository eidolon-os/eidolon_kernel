[Unit]
Description=Eidolon Hub device admission authority
After=local-fs.target network.target eidolon-channel-provider.service
Wants=eidolon-channel-provider.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=eidolon
Group=eidolon
UMask=0007
EnvironmentFile=-/etc/eidolon/hub.env
EnvironmentFile=/etc/eidolon/host.env
Environment=EIDOLON_HUB_SETTINGS_YAML=/etc/eidolon/generated/hub.yaml
ExecStart=/opt/eidolon/current/eidolon_hub/.venv/bin/uvicorn hub.main:app --host 127.0.0.1 --port 8082
Restart=on-failure
RestartSec=3s
KillSignal=SIGTERM
TimeoutStopSec=20s
StateDirectory=eidolon/hub
StateDirectoryMode=0750
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
