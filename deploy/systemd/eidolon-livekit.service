[Unit]
Description=Eidolon LiveKit RTC server
After=local-fs.target network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=eidolon
Group=eidolon
UMask=0007
EnvironmentFile=/etc/eidolon/livekit.env
EnvironmentFile=/etc/eidolon/host.env
ExecStart=/usr/bin/python3 /usr/local/libexec/eidolon-livekit-launch
Restart=on-failure
RestartSec=3s
KillSignal=SIGTERM
TimeoutStopSec=20s
RuntimeDirectory=eidolon/livekit
RuntimeDirectoryMode=0750
StateDirectory=eidolon/livekit
StateDirectoryMode=0750
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
