[Unit]
Description=Eidolon Hub Channel Provider
After=local-fs.target network-online.target eidolon-livekit.service
Wants=network-online.target eidolon-livekit.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=eidolon
Group=eidolon
UMask=0007
EnvironmentFile=/etc/eidolon/channel.env
EnvironmentFile=/etc/eidolon/host.env
Environment=EIDOLON_CHANNEL_PROVIDER_SETTINGS_YAML=/opt/eidolon/current/eidolon_channel/config/channel-provider.yaml
ExecStart=/opt/eidolon/current/eidolon_channel/.venv/bin/eidolon-channel-provider
Restart=on-failure
RestartSec=3s
KillSignal=SIGTERM
TimeoutStopSec=30s
StateDirectory=eidolon/channel
StateDirectoryMode=0750
RuntimeDirectory=eidolon/channel-provider
RuntimeDirectoryMode=0750
LogsDirectory=eidolon/channel-provider
LogsDirectoryMode=0750
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
# AF_NETLINK because this service now joins the rooms it hands out, to hear a
# device ask to be served. Gathering ICE candidates means enumerating local
# interfaces, and that is a netlink socket: without it the signalling connects,
# no host candidate is ever found, and the peer connection times out with
# nothing to say why. LiveKit and Hub carry it for the same reason.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
