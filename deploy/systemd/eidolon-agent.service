[Unit]
Description=Eidolon Agent companion brain
After=local-fs.target eidolon-nats.service eidolon-memory-discovery.service eidolon-data.service
Wants=eidolon-nats.service eidolon-memory-discovery.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=eidolon
Group=eidolon
UMask=0007
EnvironmentFile=/etc/eidolon/agent.env
EnvironmentFile=/etc/eidolon/host.env
Environment=EIDOLON_AGENT_SETTINGS_YAML=/etc/eidolon/agent.yaml
ExecStart=/opt/eidolon/current/eidolon_agent/.venv/bin/eidolon-agent
Restart=on-failure
RestartSec=3s
KillSignal=SIGTERM
TimeoutStopSec=40s
StateDirectory=eidolon/agent
StateDirectoryMode=0750
RuntimeDirectory=eidolon/agent
RuntimeDirectoryMode=0750
LogsDirectory=eidolon/agent
LogsDirectoryMode=0750
CacheDirectory=eidolon/agent
CacheDirectoryMode=0750
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
