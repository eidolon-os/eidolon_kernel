{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidolon.dev/deploy/contracts/v2/release-descriptor.schema.json",
  "title": "Eidolon Target Release Descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "target",
    "components",
    "support_sources",
    "system_assets",
    "required_secrets",
    "affected_units",
    "readiness_checks",
    "cutover_mode",
    "database_migrations"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "release_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "machine",
        "python"
      ],
      "properties": {
        "system": {
          "const": "linux"
        },
        "machine": {
          "const": "aarch64"
        },
        "python": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 7,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "support_sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/supportSource"
      }
    },
    "system_assets": {
      "type": "array",
      "minItems": 24,
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/systemAsset"
      }
    },
    "required_secrets": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "$ref": "#/$defs/requiredSecret"
      }
    },
    "affected_units": {
      "type": "array",
      "minItems": 18,
      "maxItems": 22,
      "uniqueItems": true,
      "items": {
        "enum": [
          "eidolon-admin.service",
          "eidolon-local-api.service",
          "eidolon-lifecycle-workflow.service",
          "eidolon-bootstrapd.service",
          "eidolon-unit-applier.socket",
          "eidolon-unit-applier.service",
          "eidolon-data.service",
          "eidolon-data-workspace.service",
          "eidolon-hub.service",
          "eidolon-kernel.service",
          "eidolon-nats.service",
          "eidolon-livekit.service",
          "eidolon-memory-embedder.service",
          "eidolon-memory-supervisor.service",
          "eidolon-memory-discovery.service",
          "eidolon-agent.service",
          "eidolon-channel-provider.service",
          "eidolon-channel.service",
          "eidolon-asr.service",
          "eidolon-laya.service",
          "eidolon-llm.service",
          "eidolon-tts.service"
        ]
      }
    },
    "readiness_checks": {
      "type": "array",
      "minItems": 15,
      "maxItems": 19,
      "items": {
        "$ref": "#/$defs/readinessCheck"
      }
    },
    "database_migrations": {
      "type": "array"
    },
    "cutover_mode": {
      "enum": [
        "reversible",
        "forward-only"
      ]
    },
    "capabilities": {
      "description": "What the Host this release was sealed for can do. The expected component, system asset, affected unit and readiness sets are computed from this and compared exactly; an unknown name is refused rather than selecting nothing. Absent means a Host that declares nothing, which is what every release sealed before this field existed was: a rollback reads the descriptor of the release it returns to, so requiring the field would make older releases unrestorable.",
      "type": "array",
      "items": {
        "enum": [
          "local_asr",
          "local_llm",
          "local_tts",
          "local_laya",
          "rknpu2"
        ]
      },
      "uniqueItems": true,
      "maxItems": 5
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "componentId": {
      "enum": [
        "eidolon_kernel",
        "eidolon_data",
        "eidolon_hub",
        "eidolon_admin",
        "eidolon_agent",
        "eidolon_channel",
        "eidolon_memory",
        "eidolon_models"
      ]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "revision",
        "release_path",
        "current_link",
        "source_tree_sha256",
        "lock_sha256",
        "environment_sha256",
        "required_entrypoints"
      ],
      "properties": {
        "component_id": {
          "$ref": "#/$defs/componentId"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "release_path": {
          "type": "string",
          "pattern": "^/opt/eidolon/releases/"
        },
        "current_link": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "source_tree_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "lock_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "environment_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "required_entrypoints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        }
      }
    },
    "supportSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "revision",
        "release_path",
        "source_tree_sha256"
      ],
      "properties": {
        "source_id": {
          "const": "eidolon_sdk"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "release_path": {
          "type": "string",
          "pattern": "^/opt/eidolon/releases/"
        },
        "source_tree_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "systemAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_component_id",
        "source",
        "destination",
        "sha256",
        "mode"
      ],
      "properties": {
        "source_component_id": {
          "$ref": "#/$defs/componentId"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "destination": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "mode": {
          "const": "0644"
        }
      }
    },
    "requiredSecret": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "mode"
      ],
      "properties": {
        "path": {
          "enum": [
            "/etc/eidolon/data.env",
            "/etc/eidolon/hub.env",
            "/etc/eidolon/kernel.env",
            "/etc/eidolon/admin.env",
            "/etc/eidolon/local-api.env",
            "/etc/eidolon/bootstrap.env",
            "/var/lib/eidolon-bootstrap/host_identity.ed25519",
            "/etc/eidolon/agent.env",
            "/etc/eidolon/channel.env",
            "/etc/eidolon/memory.env",
            "/etc/eidolon/livekit.env"
          ]
        },
        "mode": {
          "const": "0600"
        }
      }
    },
    "readinessCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "kind",
        "url",
        "expected_status"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,47}$"
        },
        "kind": {
          "enum": [
            "http",
            "https",
            "unix_http",
            "tcp",
            "systemd"
          ]
        },
        "url": {
          "type": "string",
          "pattern": "^(?:https?|tcp|systemd)://"
        },
        "socket": {
          "type": "string",
          "pattern": "^/run/eidolon/"
        },
        "expected_status": {
          "enum": [
            "ready",
            "ok",
            "http_2xx",
            "open",
            "active"
          ]
        }
      }
    }
  }
}
