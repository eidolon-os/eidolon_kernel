{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidolon.dev/deploy/contracts/v1/release-descriptor.schema.json",
  "title": "Eidolon Target Release Descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "target",
    "components",
    "support_sources",
    "system_assets",
    "required_secrets",
    "affected_units",
    "readiness_checks",
    "database_migrations"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "release_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "machine", "python"],
      "properties": {
        "system": {"const": "linux"},
        "machine": {"const": "aarch64"},
        "python": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"}
      }
    },
    "components": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/component"}
    },
    "support_sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"$ref": "#/$defs/supportSource"}
    },
    "system_assets": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {"$ref": "#/$defs/systemAsset"}
    },
    "required_secrets": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/requiredSecret"}
    },
    "affected_units": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["eidolon-data.service", "eidolon-kernel.service"]}
    },
    "readiness_checks": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/readinessCheck"}
    },
    "database_migrations": {
      "type": "array"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "revision",
        "release_path",
        "current_link",
        "source_tree_sha256",
        "lock_sha256",
        "environment_sha256",
        "required_entrypoints"
      ],
      "properties": {
        "component_id": {"enum": ["eidolon_kernel", "eidolon_data"]},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "release_path": {"type": "string", "pattern": "^/srv/eidolon/releases/"},
        "current_link": {"type": "string", "minLength": 1, "maxLength": 200},
        "source_tree_sha256": {"$ref": "#/$defs/sha256"},
        "lock_sha256": {"$ref": "#/$defs/sha256"},
        "environment_sha256": {"$ref": "#/$defs/sha256"},
        "required_entrypoints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 160}
        }
      }
    },
    "supportSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "revision", "release_path", "source_tree_sha256"],
      "properties": {
        "source_id": {"const": "eidolon_sdk"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "release_path": {"type": "string", "pattern": "^/srv/eidolon/releases/"},
        "source_tree_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "systemAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_component_id",
        "source",
        "destination",
        "sha256",
        "mode"
      ],
      "properties": {
        "source_component_id": {"const": "eidolon_kernel"},
        "source": {"type": "string", "minLength": 1, "maxLength": 200},
        "destination": {"type": "string", "minLength": 1, "maxLength": 200},
        "sha256": {"$ref": "#/$defs/sha256"},
        "mode": {"const": "0644"}
      }
    },
    "requiredSecret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mode"],
      "properties": {
        "path": {"type": "string", "pattern": "^/etc/eidolon/"},
        "mode": {"const": "0600"}
      }
    },
    "readinessCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "kind", "url"],
      "properties": {
        "check_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,47}$"
        },
        "kind": {"enum": ["http", "unix_http"]},
        "url": {"type": "string", "pattern": "^http://"},
        "socket": {"type": "string", "pattern": "^/run/eidolon/"}
      }
    }
  }
}
