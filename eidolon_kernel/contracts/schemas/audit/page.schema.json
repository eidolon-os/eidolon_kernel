{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidolon.dev/kernel/contracts/v1/audit/page.schema.json",
  "title": "Kernel Audit Page",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation", "next_position", "events"],
