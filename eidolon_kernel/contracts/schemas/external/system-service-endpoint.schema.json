{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidolon.dev/kernel/consumed-contracts/system/service-endpoint-v1.schema.json",
  "title": "Consumed eidolond Service Endpoint V1",
  "description": "Pinned contract for GET /api/system/v1/services/{service_id}/endpoints/{endpoint_id}; copied on 2026-08-06.",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation", "service_id", "endpoint_id", "protocol", "address", "contract"],
  "properties": {
    "operation": {"const": "system.service-endpoint"},
    "service_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "endpoint_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "protocol": {"type": "string", "minLength": 1, "maxLength": 32},
    "address": {"type": "string", "minLength": 1, "maxLength": 2048},
    "contract": {"type": "string", "minLength": 1, "maxLength": 256}
  }
}
