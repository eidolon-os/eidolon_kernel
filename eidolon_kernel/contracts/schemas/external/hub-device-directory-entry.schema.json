{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidolon.dev/kernel/consumed-contracts/hub/device-directory-entry-v1.schema.json",
  "title": "Consumed Hub Device Directory Entry V1",
  "description": "Strict consumer contract for the canonical Claim-backed Hub device directory entry.",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation", "device_id", "owner_scope", "display_name", "device_kind", "manifest", "manifest_revision", "lifecycle_state", "enrolled_at", "updated_at", "device_ref"],
  "properties": {
    "operation": {"const": "device.directory-entry"},
    "device_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "owner_scope": {"type": "string", "minLength": 1, "maxLength": 64},
    "display_name": {"type": "string", "maxLength": 128},
    "device_kind": {"type": "string", "minLength": 1, "maxLength": 96},
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "title", "properties", "actions", "events", "media"],
      "properties": {
        "schema_version": {"const": 1},
        "title": {"type": "string", "minLength": 1, "maxLength": 128},
        "properties": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/property"}},
        "actions": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/action"}},
        "events": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/event"}},
        "media": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/media"}}
      }
    },
    "manifest_revision": {"type": "string", "minLength": 1, "maxLength": 128},
    "lifecycle_state": {"enum": ["pending-approval", "approved", "revoked"]},
    "enrolled_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "device_ref": {"$ref": "#/$defs/deviceRef"}
  },
  "$defs": {
    "deviceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_instance_id", "owner_domain_id", "owner_domain_generation", "claim_generation", "trust_epoch"],
      "properties": {
        "device_instance_id": {"type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
        "owner_domain_id": {"type": "string", "minLength": 3, "maxLength": 128, "pattern": "^owner-.+$"},
        "owner_domain_generation": {"type": "integer", "minimum": 1},
        "claim_generation": {"type": "integer", "minimum": 1},
        "trust_epoch": {"type": "integer", "minimum": 1}
      }
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "schema", "observable", "writable"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "schema": {"type": "object"},
        "observable": {"type": "boolean"},
        "writable": {"type": "boolean"}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "input_schema", "output_schema", "idempotent"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "integer", "minimum": 1, "maximum": 65535},
        "input_schema": {"type": "object"},
        "output_schema": {"type": "object"},
        "idempotent": {"type": "boolean"}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "data_schema"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "data_schema": {"type": "object"}
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "direction", "codecs"],
      "properties": {
        "kind": {"enum": ["audio", "video"]},
        "direction": {"enum": ["publish", "subscribe", "bidirectional"]},
        "codecs": {"type": "array", "maxItems": 32, "items": {"type": "string"}}
      }
    }
  }
}
