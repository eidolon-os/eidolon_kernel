{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidolon.dev/kernel/contracts/v1/body-mesh/assignment.schema.json",
  "title": "Body Assignment Fact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "assignment_id",
    "body_endpoint_id",
    "device_id",
    "endpoint_id",
    "owner_id",
    "companion_id",
    "selection_provenance",
    "change_reason",
    "mode",
    "policy_refs",
    "revision",
    "generation",
    "updated_at",
    "status"
  ],
  "properties": {
    "operation": {
      "const": "kernel.body-assignment"
    },
    "assignment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "body_endpoint_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "device_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "endpoint_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "owner_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "companion_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 64
    },
    "selection_provenance": {
      "enum": [
        "user_selected",
        "user_cleared",
        "companion_deleted",
        "policy_reconciled"
      ]
    },
    "change_reason": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 256
    },
    "mode": {
      "const": "default"
    },
    "policy_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "uniqueItems": true,
      "maxItems": 16
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "object"
    }
  }
}
