{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidolon.dev/kernel/contracts/v1/body-mesh/page.schema.json",
  "title": "Body Endpoint Page",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "endpoints"
  ],
  "properties": {
    "operation": {
      "const": "kernel.body-endpoint-page"
    },
    "endpoints": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "endpoint.schema.json"
      }
    }
  }
}
