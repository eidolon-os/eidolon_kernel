{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidolon.dev/system/contracts/service-endpoint-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation", "service_id", "endpoint_id", "protocol", "address", "contract"],
  "properties": {
    "operation": {"const": "system.service-endpoint"},
    "service_id": {"type": "string", "minLength": 1},
    "endpoint_id": {"type": "string", "minLength": 1},
    "protocol": {"type": "string", "minLength": 1},
    "address": {"type": "string", "minLength": 1},
    "contract": {"type": "string", "minLength": 1}
  }
}
